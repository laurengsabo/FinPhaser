/*
 * ============================================================
 *  FinPhaser — nextflow.config
 * ============================================================
 *  Central configuration.  Select a profile at run time:
 *
 *    nextflow run main.nf -profile conda          # local conda (default)
 *    nextflow run main.nf -profile mamba          # faster env solves
 *    nextflow run main.nf -profile docker         # Docker container
 *    nextflow run main.nf -profile singularity    # HPC / Singularity
 *    nextflow run main.nf -profile test           # bundled test data
 *
 *  Override any param on the command line:
 *    nextflow run main.nf -profile conda --vcf path/to/my.vcf
 * ============================================================
 */

// ── Default parameters ────────────────────────────────────────────────────────
params {

    // ── Required inputs ──────────────────────────────────────────────────────
    vcf          = "data/raw/YHPedigree1_FilteredSNVs.recode.vcf"
    samples_yml  = "config/samples.yml"

    // ── Output ───────────────────────────────────────────────────────────────
    outdir   = "results"
    tracedir = "${params.outdir}/pipeline_info"

    // ── ancestry_hmm / mod_vcf2ahmm parameters ───────────────────────────────
    // These mirror the hmm block in samples.yml and are forwarded as CLI
    // flags to mod_vcf2ahmm.py.  Override here or via --hmm_* on the CLI.
    hmm_recombination_rate   = 1.0e-8   // -r  Morgans/bp
    hmm_min_distance_bp      = 1000     // -m  min bp between kept SNPs
    hmm_min_allele_freq_diff = 0.1      // --min_diff
    hmm_use_genotypes        = 0        // -g  0=read counts, 1=genotypes

    // ── Misc ─────────────────────────────────────────────────────────────────
    help = false
}

// ── Default process resources ─────────────────────────────────────────────────
process {
    cpus   = 1
    memory = '4 GB'
    time   = '2 h'

    withName: 'RUN_ANCESTRY_HMM' {
        cpus   = 4
        memory = '16 GB'
        time   = '6 h'
    }
    withName: 'PHASE_PARENTS' {
        cpus   = 2
        memory = '8 GB'
    }
    withName: 'RUN_SPORE' {
        cpus   = 2
        memory = '8 GB'
    }
}

// ── Execution profiles ────────────────────────────────────────────────────────
profiles {

    // ── conda ────────────────────────────────────────────────────────────────
    // Builds/reuses a conda environment from environment.yml.
    // First run will solve and create the environment (~5–10 min);
    // subsequent runs reuse the cached env.
    conda {
        conda.enabled       = true
        conda.useMamba      = false
        process.conda       = "${projectDir}/environment.yml"
        docker.enabled      = false
        singularity.enabled = false
    }

    // ── mamba ────────────────────────────────────────────────────────────────
    // Same as conda but uses mamba for faster dependency solving.
    // Requires: conda install -n base -c conda-forge mamba
    mamba {
        conda.enabled       = true
        conda.useMamba      = true
        process.conda       = "${projectDir}/environment.yml"
        docker.enabled      = false
        singularity.enabled = false
    }

    // ── docker ───────────────────────────────────────────────────────────────
    // Requires Docker Desktop (Mac/Windows) or Docker Engine (Linux).
    // Build the image first:  docker build -t finphaser:latest .
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        conda.enabled       = false
        singularity.enabled = false
        process.container   = 'finphaser:latest'
    }

    // ── singularity ──────────────────────────────────────────────────────────
    // Preferred on HPC clusters where Docker is not available.
    // Build: singularity build finphaser.sif docker://finphaser:latest
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        process.container      = 'finphaser:latest'
    }

    // ── test ─────────────────────────────────────────────────────────────────
    // Runs on the small bundled test dataset in data/test/.
    // Exercises all pipeline steps and completes in minutes.
    test {
        conda.enabled      = true
        conda.useMamba     = false
        process.conda      = "${projectDir}/environment.yml"
        params.vcf         = "${projectDir}/data/test/test_FilteredSNVs.recode.vcf"
        params.samples_yml = "${projectDir}/config/test_samples.yml"
        params.outdir      = "test_results"
        process {
            cpus   = 1
            memory = '2 GB'
            time   = '30 min'
        }
    }
}

// ── Reporting & tracing ───────────────────────────────────────────────────────
timeline {
    enabled   = true
    file      = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.tracedir}/execution_report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.tracedir}/execution_trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.tracedir}/pipeline_dag.html"
    overwrite = true
}

// ── Manifest ──────────────────────────────────────────────────────────────────
manifest {
    name            = 'FinPhaser'
    author          = 'FinPhaser Contributors'
    homePage        = 'https://github.com/your-username/FinPhaser'
    description     = 'Local ancestry inference and IBD detection in hybrid cichlid populations'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}