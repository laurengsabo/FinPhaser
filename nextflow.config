/*
 * ============================================================
 *  FinPhaser — nextflow.config
 * ============================================================
 *  Central configuration. Select a profile with -profile:
 *
 *    nextflow run main.nf -profile conda          # local conda (default)
 *    nextflow run main.nf -profile mamba          # faster env solves
 *    nextflow run main.nf -profile docker         # Docker container
 *    nextflow run main.nf -profile singularity    # HPC / Singularity
 *    nextflow run main.nf -profile test           # bundled test data
 *
 *  Any param can be overridden on the CLI:
 *    nextflow run main.nf -profile conda --spore_max_cores 8
 * ============================================================
 */

// ── Default parameters ────────────────────────────────────────────────────────
params {

    // ── Required inputs ──────────────────────────────────────────────────────
    // The VCF path is read from the vcf: key inside samples.yml.
    // Only the YAML path is needed here — it is the single config entry point.
    samples_yml  = "config/samples.yml"

    // ── Output ───────────────────────────────────────────────────────────────
    outdir   = "results"
    tracedir = "${params.outdir}/pipeline_info"

    // ── ancestry_hmm / mod_vcf2ahmm parameters ───────────────────────────────
    // Forwarded as CLI flags to mod_vcf2ahmm.py (unmodified script).
    hmm_recombination_rate   = 1.0e-8   // -r  Morgans/bp
    hmm_min_distance_bp      = 1000     // -m  min bp between kept SNPs
    hmm_min_allele_freq_diff = 0.1      // --min_diff
    hmm_use_genotypes        = 0        // -g  0=read counts, 1=genotypes

    // ── SPORE / TRUFFLE parameters ────────────────────────────────────────────
    // Resource limits for the RUN_SPORE process.
    // All other SPORE settings come from the spore: block in samples.yml.
    spore_max_cores  = 4
    spore_max_memory = "4 GB"

    // ── Misc ─────────────────────────────────────────────────────────────────
    help = false
}

// ── Default process resources ─────────────────────────────────────────────────
process {
    cpus   = 1
    memory = '4 GB'
    time   = '2 h'

    withName: 'RUN_ANCESTRY_HMM' {
        cpus   = 4
        memory = '16 GB'
        time   = '6 h'
    }
    withName: 'PHASE_PARENTS' {
        cpus   = 2
        memory = '8 GB'
    }
    withName: 'RUN_SPORE' {
        cpus   = { params.spore_max_cores }
        memory = { params.spore_max_memory }
        time   = '8 h'
    }

    // ── Per-process conda environment assignments ─────────────────────────────
    // Two environments are used to avoid dependency conflicts:
    //   finphaser.yml — Python + ancestry_hmm + bcftools (all non-R steps)
    //   spore.yml     — R 3.6.3 + SPORE dependencies (RUN_SPORE only)
    withName: 'PHASE_PARENTS'     { conda = "${projectDir}/envs/finphaser.yml" }
    withName: 'PREPARE_HMM_INPUT' { conda = "${projectDir}/envs/finphaser.yml" }
    withName: 'RUN_ANCESTRY_HMM'  { conda = "${projectDir}/envs/finphaser.yml" }
    withName: 'ANCESTRY_SUMMARY'  { conda = "${projectDir}/envs/finphaser.yml" }
    withName: 'COMPRESS_VCF'      { conda = "${projectDir}/envs/finphaser.yml" }
    withName: 'WRITE_SEX_TSV'     { conda = "${projectDir}/envs/finphaser.yml" }
    withName: 'RANK_IBD'          { conda = "${projectDir}/envs/finphaser.yml" }
    withName: 'RUN_SPORE'         { conda = "${projectDir}/envs/spore.yml"     }
}

// ── Execution profiles ────────────────────────────────────────────────────────
profiles {

    // ── conda ────────────────────────────────────────────────────────────────
    conda {
        conda.enabled       = true
        conda.useMamba      = false
        docker.enabled      = false
        singularity.enabled = false
    }

    // ── mamba ────────────────────────────────────────────────────────────────
    mamba {
        conda.enabled       = true
        conda.useMamba      = true
        docker.enabled      = false
        singularity.enabled = false
    }

    // ── docker ───────────────────────────────────────────────────────────────
    // Build first: docker build -t finphaser:latest .
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        conda.enabled       = false
        singularity.enabled = false
        process.container   = 'finphaser:latest'
    }

    // ── singularity ──────────────────────────────────────────────────────────
    // Build: singularity build finphaser.sif docker://finphaser:latest
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        process.container      = 'finphaser:latest'
    }

    // ── test ─────────────────────────────────────────────────────────────────
    // The VCF path for the test run lives inside config/test_samples.yml
    // under the vcf: key — consistent with the main run pattern.
    test {
        conda.enabled      = true
        conda.useMamba     = false
        params.samples_yml = "${projectDir}/config/test_samples.yml"
        params.outdir      = "test_results"
        process {
            cpus   = 1
            memory = '2 GB'
            time   = '30 min'
        }
    }
}

// ── Reporting & tracing ───────────────────────────────────────────────────────
timeline {
    enabled   = true
    file      = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.tracedir}/execution_report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.tracedir}/execution_trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.tracedir}/pipeline_dag.html"
    overwrite = true
}

// ── Manifest ──────────────────────────────────────────────────────────────────
manifest {
    name            = 'FinPhaser'
    author          = 'FinPhaser Contributors'
    homePage        = 'https://github.com/your-username/FinPhaser'
    description     = 'Local ancestry inference and IBD detection in hybrid cichlid populations'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
